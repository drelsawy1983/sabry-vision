class SabryVisionModuleThree:
    def __init__(self, bot_token, chat_id):
        self.bot_token = bot_token
        self.chat_id = chat_id
        self.api_url = f"https://api.telegram.org/bot{self.bot_token}/sendMessage"

    # ==========================================
    # 1. نظام إرسال تنبيهات التليجرام الصارم
    # ==========================================
    def send_telegram_alert(self, symbol, score, classification, price, fair_value, strategy_name):
        """
        إرسال تنبيهات إشارات صبري فيجن إلى بوت التليجرام للإشارات المقبولة فقط (Score >= 40)
        """
        message_text = (
            f"🚀 **إشارة صبري فيجن - {classification}**\n\n"
            f"📌 **الرمز (Watchlist):** `{symbol}`\n"
            f"📊 **الدرجة النهائية:** `{score} / 100`\n"
            f"💰 **السعر الحالي:** `{price}`\n"
            f"🎯 **القيمة العادلة (Fair Value):** `{fair_value}`\n"
            f"🛠️ **الاستراتيجية:** `{strategy_name}`\n\n"
            f"⏰ **التوقيت:** {datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')}"
        )
        
        payload = {
            "chat_id": self.chat_id,
            "text": message_text,
            "parse_mode": "Markdown"
        }
        
        try:
            response = requests.post(self.api_url, data=payload, timeout=5)
            return response.status_code == 200
        except Exception as e:
            print(f"خطأ أثناء إرسال التنبيه عبر التليجرام: {e}")
            return False

    # ==========================================
    # 2. محرك اختبار الأداء التاريخي (Backtest Engine)
    # ==========================================
    def run_backtest_simulation(self, df_historical, trailing_mode, strategy_name):
        """
        محاكاة اختبار الأداء التاريخي وفق استراتيجيات التتبع وشروط حماية صبري فيجن
        """
        trades = []
        in_position = False
        entry_price = 0.0
        
        for index, row in df_historical.iterrows():
            # محاكاة شروط الدخول بناءً على السكور الصارم
            if not in_position and row['Score'] >= 60:  # Good أو Elite
                in_position = True
                entry_price = row['Close']
                trades.append({
                    "Date": index,
                    "Type": "ENTRY",
                    "Price": entry_price,
                    "Strategy": strategy_name
                })
            elif in_position:
                # محاكاة شرط الخروج حسب وضع التتبع
                profit_target = entry_price * 1.05
                stop_loss = entry_price * 0.97
                
                if row['High'] >= profit_target or row['Low'] <= stop_loss:
                    exit_price = profit_target if row['High'] >= profit_target else stop_loss
                    in_position = False
                    trades.append({
                        "Date": index,
                        "Type": "EXIT",
                        "Price": exit_price,
                        "PnL_%": round(((exit_price - entry_price) / entry_price) * 100, 2)
                    })
                    
        return pd.DataFrame(trades)

    # ==========================================
    # 3. إدارة التخزين المؤقت وحماية الموارد (Caching Engine)
    # ==========================================
    @staticmethod
    def load_cached_financial_data(filepath="financial_cache.json"):
        """
        تحميل بيانات القيمة العادلة والصحة المالية المخزنة سابقاً لتفادي إعادة الحظر
        """
        try:
            with open(filepath, "r", encoding="utf-8") as f:
                return json.load(f)
        except FileNotFoundError:
            return {}

    @staticmethod
    def save_cached_financial_data(data_dict, filepath="financial_cache.json"):
        """
        حفظ بيانات التقييم المالي في ملف محلي أو ربطها بجوجل شيت لاحقاً
        """
        with open(filepath, "w", encoding="utf-8") as f:
            json.dump(data_dict, f, ensure_ascii=False, indent=4)
